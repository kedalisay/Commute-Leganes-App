{
  "name": "commute-leganes-app",
  "version": "0.1.0-alpha.1",
  "description": "Helping you find your way around Leganes, Iloilo.",
  "main": "main.js",
  "scripts": {
    "tailwind": "npx tailwindcss -i src/css/input.css -o dist/tailwind.css --watch",
    "esbuild": "npx esbuild src/js/main.js --outfile=dist/output.js --format=esm --bundle --watch",
    "build:tailwind": "npx @tailwindcss/cli -i src/css/input.css -o dist/tailwind.css --minify",
    "build:esbuild": "node build.mjs",
    "build": "npm-run-all --parallel build:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kedalisay/Commute-Leganes-App.git"
  },
  "author": "Keane Emanuel Dalisay",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/kedalisay/Commute-Leganes-App/issues"
  },
  "homepage": "https://github.com/kedalisay/Commute-Leganes-App#readme",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "esbuild": "^0.28.2",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "maplibre-gl": "^6.13.0"
  }
}
